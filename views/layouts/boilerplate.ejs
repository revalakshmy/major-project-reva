    <!-- JS CODE FOR SPLASH SCREEN ONLY -->
     <script>
(function () {
  const splash = document.getElementById("splash-screen");
  const bar = document.querySelector(".splash-progress-bar");
  const percent = document.querySelector(".splash-percent");

  if (!splash || !bar || !percent) return;

  // SETTINGS
  const STEPS = [0, 12, 27, 45, 63, 78, 90];  // visible jumps
  const STEP_INTERVAL = 220;                 // ms between jumps
  const MIN_VISIBLE = 1200;                  // splash must stay minimum this long
  const FINISH_SPEED = 300;                  // final 90 -> 100 animation

  let started = performance.now();
  let finishedSteps = false;

  // animate bar to X%
  const setPercent = (v) => {
    bar.style.width = v + "%";
    percent.textContent = v + "%";
  };

  // step runner
  let i = 0;
  function runSteps() {
    if (i < STEPS.length) {
      setPercent(STEPS[i]);
      i++;
      setTimeout(runSteps, STEP_INTERVAL);
    } else {
      finishedSteps = true;
      maybeFinish();
    }
  }

  // try finishing after load + min visible time
  function maybeFinish() {
    const elapsed = performance.now() - started;
    const wait = Math.max(0, MIN_VISIBLE - elapsed);

    setTimeout(() => {
      bar.style.transition = `width ${FINISH_SPEED}ms ease-out`;
      setPercent(100);

      setTimeout(() => {
        splash.classList.add("splash-hidden");
        setTimeout(() => splash.remove(), 600);
      }, 350);
    }, wait);
  }

  // when page loads, finish if steps done
  window.addEventListener("load", () => {
    if (finishedSteps) {
      maybeFinish();
    } else {
      // wait until steps done
      const t = setInterval(() => {
        if (finishedSteps) {
          clearInterval(t);
          maybeFinish();
        }
      }, 70);
    }
  });

  // start animation
  bar.style.transition = `width ${STEP_INTERVAL - 40}ms linear`;
  runSteps();

})();
</script>



  


