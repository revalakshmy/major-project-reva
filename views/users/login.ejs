<% layout("/layouts/boilerplate") %>

<!--
  Premium Login view (frontend-only)
  - Keeps backend unchanged: action="/login" method="post", name="username", name="password"
  - Includes show/hide password, remember checkbox and forgot link (front-end only)
-->

<style>
  /* Container */
  .auth-page {
    min-height: 72vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 36px 18px;
    background: radial-gradient(700px 220px at 8% 12%, rgba(110,75,255,0.02), transparent),
                linear-gradient(180deg, #071022 0%, #0b1724 100%);
    color: var(--text, #e6eef8);
    font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, Arial;
  }

  .auth-card {
    width: 100%;
    max-width: 420px;
    background: linear-gradient(180deg, rgba(255,255,255,0.012), rgba(255,255,255,0.008));
    border: 1px solid rgba(255,255,255,0.03);
    box-shadow: 0 18px 50px rgba(3,8,15,0.65), inset 0 1px 0 rgba(255,255,255,0.02);
    border-radius: 12px;
    padding: 26px;
  }

  /* Heading (gradient like signup) */
  .auth-title {
    text-align: center;
    font-family: 'Poppins', system-ui, -apple-system, "Segoe UI", Roboto, Arial;
    font-weight: 700;
    font-size: 22px;
    margin-bottom: 18px;
    background: linear-gradient(135deg, #8fc6ff, #e38dff, #ff7bd5);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 2px 14px rgba(255,120,220,0.12);
  }

  .form-row { margin-bottom: 12px; }
  label.form-label {
    display:block;
    color: rgba(255,255,255,0.78);
    font-size: 13px;
    margin-bottom: 8px;
  }

  /* Input + light background like reference */
  .input-wrap {
    position: relative;
  }

  .input-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(6, 15, 30, 0.6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  input.form-control {
    width: 100%;
    padding: 12px 14px 12px 40px;
    border-radius: 6px;
    border: 1px solid rgba(0,0,0,0.06);
    background: rgba(246,249,255,0.96); /* light background like reference */
    color: #0b1220;
    font-weight: 500;
    box-shadow: none;
  }
  input.form-control::placeholder { color: rgba(11,18,32,0.45); }

  input.form-control:focus {
    outline: none;
    border-color: rgba(155,107,255,0.85);
    box-shadow: 0 8px 20px rgba(110,75,255,0.06);
  }

  /* Password show/hide button */
  .pw-toggle {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    padding: 6px;
    cursor: pointer;
    color: rgba(11,18,32,0.6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* small form actions row */
  .form-actions {
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-top:6px;
    margin-bottom:10px;
    gap:8px;
    font-size: 13px;
  }
  .remember {
    display:flex;
    align-items:center;
    gap:8px;
    color: rgba(255,255,255,0.78);
  }
  .forgot-link {
    color: #7aa7ff;
    text-decoration: none;
    font-weight: 600;
  }
  .forgot-link:hover { text-decoration: underline; }

  /* Primary white pill (reference) */
  .primary-pill {
    display:block;
    width: 100%;
    background: #ffffff;
    color: #0b1220;
    font-weight: 700;
    text-align:center;
    padding: 12px 14px;
    border-radius: 8px;
    border: none;
    box-shadow: 0 8px 20px rgba(3,8,15,0.28);
    cursor: pointer;
    transition: transform .12s ease, filter .12s ease;
  }
  .primary-pill:hover { transform: translateY(-1px); filter: brightness(0.98); }

  /* small note / helper below */
  .auth-note {
    margin-top:12px;
    color: rgba(255,255,255,0.7);
    font-size: 13px;
    text-align:center;
  }

  @media (max-width:480px) {
    .auth-card { padding: 18px; }
  }

  /* validation visuals used by bootstrap-like script */
  .was-validated input:invalid { box-shadow: 0 0 0 3px rgba(255,80,80,0.06); border-color: rgba(255,80,80,0.7); }
</style>

<div class="auth-page">
  <div class="auth-card" role="region" aria-labelledby="login-title">
    <h2 id="login-title" class="auth-title">Welcome back to StayZly</h2>

    <form action="/login" method="post" class="needs-validation" novalidate>
      <!-- Username -->
      <div class="form-row">
        <label for="username" class="form-label">Email Address or Username</label>
        <div class="input-wrap">
          <span class="input-icon" aria-hidden="true">
            <!-- mail/user icon -->
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 8.6v7.2A2.2 2.2 0 005.2 18h13.6A2.2 2.2 0 0021 15.8V8.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 8.6l8.7 6.2a2 2 0 002.6 0L21 8.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <input name="username" id="username" type="text" class="form-control" placeholder="you@example.com or username" required />
          <div class="invalid-feedback">Please enter your email or username</div>
        </div>
      </div>

      <!-- Password -->
      <div class="form-row">
        <label for="password" class="form-label">Password</label>
        <div class="input-wrap">
          <span class="input-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 11V8a5 5 0 0110 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </span>
          <input name="password" id="password" type="password" class="form-control" placeholder="Your password" required />
          <button type="button" class="pw-toggle" aria-label="Show password" id="pw-toggle">
            <!-- eye icon -->
            <svg id="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/></svg>
            <svg id="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" style="display:none"><path d="M17.94 17.94A10.94 10.94 0 0112 19c-7 0-11-7-11-7a21.86 21.86 0 015.18-5.94" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M1 1l22 22" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="invalid-feedback">Please enter your password</div>
        </div>
      </div>

      <!-- remember / forgot row -->
      <div class="form-actions">
        <label class="remember"><input type="checkbox" name="remember" /> Remember me</label>
        <a class="forgot-link" href="/forgot">Forgot password?</a>
      </div>

      <button class="login-submit-btn" type="submit">Sign In</button>




      <div class="auth-note">
        Don’t have an account? <a href="/signup" style="color:#7aa7ff; font-weight:600; text-decoration:none">Create one</a>
      </div>
    </form>
  </div>
</div>

<script>
  // show/hide password (client-side only)
  (function () {
    const pwInput = document.getElementById('password');
    const toggle = document.getElementById('pw-toggle');
    const eyeOpen = document.getElementById('eye-open');
    const eyeClosed = document.getElementById('eye-closed');

    if (toggle && pwInput) {
      toggle.addEventListener('click', () => {
        if (pwInput.type === 'password') {
          pwInput.type = 'text';
          if (eyeOpen) eyeOpen.style.display = 'none';
          if (eyeClosed) eyeClosed.style.display = 'inline';
          toggle.setAttribute('aria-label', 'Hide password');
        } else {
          pwInput.type = 'password';
          if (eyeOpen) eyeOpen.style.display = 'inline';
          if (eyeClosed) eyeClosed.style.display = 'none';
          toggle.setAttribute('aria-label', 'Show password');
        }
      });
    }

    // simple form validation (bootstrap-like)
    (function () {
      'use strict';
      const forms = document.querySelectorAll('.needs-validation');
      Array.prototype.slice.call(forms).forEach(function (form) {
        form.addEventListener('submit', function (event) {
          if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }
          form.classList.add('was-validated');
        }, false);
      });
    })();
  })();
</script>
