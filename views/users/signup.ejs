<% layout("/layouts/boilerplate") %>

<!--
  Upgraded signup UI (frontend-only)
  - Keeps form action="/signup" method="post" and input names unchanged:
    name="username", name="email", name="password"
  - Styles are included inline so you can drop this in and see it immediately.
  - If you prefer the CSS moved to public/css/style.css, tell me and I will provide that snippet.
-->

<style>
  /* Card + page layout */
  .auth-page {
    min-height: 76vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 36px 18px;
    background: radial-gradient(900px 300px at 10% 12%, rgba(110,75,255,0.03), transparent),
                linear-gradient(180deg, #071022 0%, #0b1724 100%);
    font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    color: var(--text, #e6eef8);
  }

  .auth-card {
    width: 100%;
    max-width: 420px;
    border-radius: 12px;
    padding: 28px 28px 30px;
    background: linear-gradient(180deg, rgba(255,255,255,0.015), rgba(255,255,255,0.01));
    box-shadow: 0 14px 40px rgba(3,8,15,0.6), inset 0 1px 0 rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.03);
  }

  .auth-title {
    text-align: center;
    font-family: 'Poppins', system-ui, -apple-system, "Segoe UI", Roboto, Arial;
    font-weight: 700;
    font-size: 22px;
    color: #f3a3e6;
    margin-bottom: 16px;
  }

  /* Form row */
  .form-row { margin-bottom: 14px; }

  label.form-label {
    display:block;
    color: rgba(255,255,255,0.7);
    font-size: 13px;
    margin-bottom: 8px;
  }

  /* Input look */
  .input-wrap {
    position: relative;
  }
  .input-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.55);
    pointer-events: none;
  }
  input.form-control,
  input.form-control[type="password"] {
    width: 100%;
    padding: 12px 14px 12px 40px; /* room for icon */
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.04);
    background: rgba(15,32,56,0.9);
    color: #dbe9ff;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.01);
    transition: box-shadow .14s ease, border-color .14s ease, transform .08s ease;
    -webkit-appearance: none;
  }
  input.form-control::placeholder { color: rgba(255,255,255,0.35); }

  input.form-control:focus {
    outline: none;
    border-color: rgba(155,107,255,0.9);
    box-shadow: 0 8px 20px rgba(110,75,255,0.06);
    background: rgba(12,26,46,0.95);
  }

  /* subtle helper line under inputs */
  .hint {
    font-size: 12px;
    color: rgba(255,255,255,0.55);
    margin-top: 6px;
  }

  /* Submit button (pill gradient) */
  .submit-pill {
    margin-top: 18px;
    display: block;
    width: 190px;
    margin-left: auto;
    margin-right: auto;
    padding: 11px 20px;
    border-radius: 999px;
    text-align: center;
    font-weight: 700;
    font-size: 15px;
    color: #fff;
    border: none;
    background: linear-gradient(135deg, #9b6bff, #ff6ad5);
    box-shadow: 0 12px 30px rgba(155,107,255,0.18);
    cursor: pointer;
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .submit-pill:active { transform: translateY(1px); }
  .submit-pill:hover { filter: brightness(1.03); }

  /* Note box */
  .note-box {
    margin-top: 14px;
    background: linear-gradient(180deg, rgba(155,107,255,0.04), rgba(110,75,255,0.02));
    border: 1px solid rgba(155,107,255,0.18);
    color: rgba(255,255,255,0.92);
    padding: 12px;
    border-radius: 10px;
    font-size: 13px;
    line-height: 1.35;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.015);
  }

  /* Small screens */
  @media (max-width: 480px) {
    .auth-card { padding: 20px; max-width: 360px; }
    .auth-title { font-size: 20px; }
    .submit-pill { width: 100%; }
  }

  /* Accessibility focus outlines for keyboard users */
  input.form-control:focus-visible { outline: 3px solid rgba(155,107,255,0.12); }

  /* Minimal style for file input label (visual only) */
  .file-visual {
    display: flex;
    gap: 10px;
    align-items: center;
    background: rgba(12,24,40,0.7);
    border: 1px solid rgba(255,255,255,0.04);
    padding: 10px 12px;
    border-radius: 8px;
    color: rgba(255,255,255,0.75);
    font-size: 13px;
  }
  .file-visual button { background: rgba(255,255,255,0.04); border: none; color: #fff; padding: 6px 10px; border-radius: 6px; cursor: pointer; }
</style>

<div class="auth-page">
  <div class="auth-card" role="region" aria-labelledby="signup-title">
    <h2 id="signup-title" class="stayzly-heading">Join the StayZly community</h2>

    <!-- KEEP ACTION / METHOD / NAME ATTRIBUTES EXACTLY AS YOUR BACKEND EXPECTS -->
    <form action="/signup" method="post" class="needs-validation" novalidate>
      <!-- Username -> labeled "Full name" visually, but name kept as username -->
      <div class="form-row">
        <label for="username" class="form-label">Full Name</label>
        <div class="input-wrap">
          <span class="input-icon" aria-hidden="true">
            <!-- user icon -->
            <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse"
  data-bs-target="#navbarNavAltMarkup" aria-label="Toggle navigation">
  
  <span class="custom-toggler-icon">
    <svg width="26" height="26" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none"
         stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </span>

</button>

          </span>
          <input
            name="username"
            id="username"
            type="text"
            class="form-control"
            placeholder="John Doe"
            required
          />
          <div class="invalid-feedback">Please enter your name</div>
        </div>
      </div>

      <!-- Email -->
      <div class="form-row">
        <label for="email" class="form-label">Email Address</label>
        <div class="input-wrap">
          <span class="input-icon" aria-hidden="true">
            <!-- email icon -->
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 8.6v7.2A2.2 2.2 0 005.2 18h13.6A2.2 2.2 0 0021 15.8V8.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 8.6l8.7 6.2a2 2 0 002.6 0L21 8.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <input
            name="email"
            id="email"
            type="email"
            class="form-control"
            placeholder="you@example.com"
            required
          />
          <div class="invalid-feedback">Please enter a valid email</div>
        </div>
      </div>

      <!-- Password -->
      <div class="form-row">
        <label for="password" class="form-label">Password</label>
        <div class="input-wrap" style="display:flex; align-items:center;">
          <span class="input-icon" aria-hidden="true" style="left:12px;">
            <!-- lock icon -->
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 11V8a5 5 0 0110 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </span>
          <input
            name="password"
            id="password"
            type="password"
            class="form-control"
            placeholder="Create a password"
            required
          />
          <div class="invalid-feedback">Please provide a password</div>
        </div>
      </div>

      <!-- Note box -->
      <div class="note-box" role="note">
        <strong>Note:</strong> We use industry standard encryption to protect your account. By creating an account you agree to our Terms.
      </div>

      <button type="submit" class="submit-pill"
  style="margin-top:18px; display:block; width:190px; margin-left:auto; margin-right:auto; padding:12px 22px;
         border-radius:999px; font-weight:700; font-size:15px; color:#fff;
         background: linear-gradient(135deg, rgba(129,99,255,0.35), rgba(255,110,199,0.35));
         border: 1px solid rgba(255,255,255,0.18);
         backdrop-filter: blur(12px);
         -webkit-backdrop-filter: blur(12px);
         box-shadow: 0 8px 25px rgba(155,107,255,0.25), inset 0 1px 1px rgba(255,255,255,0.2);
         cursor:pointer; transition: transform .15s ease, filter .2s ease, box-shadow .2s ease;">
  Join
</button>

    </form>
  </div>
</div>

<script>
  // Bootstrap-like client validation (no backend changed)
  (function () {
    'use strict';
    const forms = document.querySelectorAll('.needs-validation');
    Array.prototype.slice.call(forms).forEach(function (form) {
      form.addEventListener('submit', function (event) {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  })();
</script>
