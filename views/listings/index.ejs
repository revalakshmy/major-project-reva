<% layout("/layouts/boilerplate") %>

<body>

  <!-- HERO -->
  <section class="stayzly-hero">
    <h2>Find your perfect stay</h2>
    <p>Discover amazing places to stay around the world</p>
  </section>

  <!-- CONTROLS -->
  <section class="container content">
    <div class="stayzly-controls" style="margin-top:12px;">
      <div class="stayzly-results"><%= allListings.length %> stays found</div>
      
    </div>

    <!-- LISTINGS GRID -->
    <div class="stayzly-list-grid">

      <% for (let listing of allListings) { %>

        <article class="stayzly-card listing-card card">

          <a href="/listings/<%= listing._id %>" class="listing-link" style="text-decoration:none; color:inherit;">

            <!-- IMAGE -->
            <div class="media-wrap" style="position:relative;">
              <img
                src="<%- listing.image.url %>"
                alt="<%= listing.title %>"
                class="card-img-top stayzly-media"
                style="height:220px; object-fit:cover;"
              />

              <% if (listing.isVerified) { %>
                <div class="stayzly-badge verified">✔ Verified</div>
              <% } %>

              <% if (listing.available === false || listing.isAvailable === false) { %>
                <div class="stayzly-badge unavailable">Not Available</div>
              <% } %>
            </div>

            <!-- CARD BODY -->
            <div class="card-body" style="padding:16px 18px;">

              <!-- TITLE + RATING -->
              <div class="stayzly-title-row">
                <h5><%= listing.title %></h5>

                <% if (listing.rating) { %>
                  <div class="stayzly-rating">★ <%= listing.rating %></div>
                <% } %>
              </div>

              <!-- LOCATION -->
              <div class="stayzly-meta">
                <span>📍 <%= listing.location %></span>
              </div>

              <!-- INFO ROW (guests, beds, baths) -->
              <div class="stayzly-info-row">
                    <span><i class="fa-solid fa-users"></i> <%= listing.guests || 1 %></span>
                    <span><i class="fa-solid fa-bed"></i> <%= listing.bedrooms || 1 %></span>
                    <span><i class="fa-solid fa-bath"></i> <%= listing.bathrooms || 1 %></span>
             </div>


              <!-- PRICE + REVIEW COUNT -->
              <div class="stayzly-price-row" style="margin-top:14px; display:flex; justify-content:space-between; align-items:center;">
                
                <div class="stayzly-price">
                  ₹<%= listing.price.toLocaleString("en-IN") %>
                  <span style="color:#9aa6b2;"> / night</span>
                  <i class="tax-info" style="display:none;"> +18% GST</i>
                </div>

                <% if (listing.reviews && listing.reviews.length > 0) { %>
                  <div class="stayzly-review-count" style="color:#9aa6b2; font-size:14px;">
                    (<%= listing.reviews.length %> reviews)
                  </div>
                <% } %>

              </div>

            </div> <!-- END card-body -->

          </a>

        </article>

      <% } %> <!-- END FOR LOOP -->

    </div> <!-- END GRID -->

  </section>

  <!-- TAX TOGGLE SCRIPT -->
  <script>
    (function () {
      const taxbutton = document.getElementById("switchCheckDefault");
      if (!taxbutton) return;
      taxbutton.addEventListener("click", () => {
        const taxinfo = document.getElementsByClassName("tax-info");
        for (const info of taxinfo) {
          info.style.display = info.style.display !== "inline" ? "inline" : "none";
        }
      });
    })();
  </script>

</body>
