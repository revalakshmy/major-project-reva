          <div class="d-flex align-items-start justify-content-between">
            <div>
              <h2 class="mb-1" style="font-weight:600; font-size:20px; color:#fff;"><%= listing.title %></h2>
              <div class="d-flex align-items-center gap-3" style="color:var(--stay-muted); font-size:14px;">
                <% if (typeof avgRating !== "undefined") { %>
                  <span>★ <strong style="color:#ffd84d; margin-right:6px;"><%= avgRating %></strong> (<%= listing.reviews.length %> reviews)</span>
                <% } %>
                <span>📍 <%= listing.location %></span>
              </div>
            </div>

            <% if(listing.isVerified) { %>
              <div class="stayzly-badge verified">✔ Verified</div>
            <% } %>
          </div>
        </section>

        <!-- QUICK SPECS -->
        <section class="stayzly-card p-3 mb-3" style="border-radius:12px;">
          <div class="d-flex justify-content-between text-center">
            <div style="flex:1;">
              <div style="font-size:18px; color:var(--stay-accent);"><i class="fa-solid fa-user-group"></i></div>
              <div style="color:var(--stay-muted); font-size:14px; margin-top:8px;">
                <% if(listing.guests) { %><%= listing.guests %> Guests<% } else { %>Guests<% } %>
              </div>
            </div>
            <div style="flex:1;">
              <div style="font-size:18px; color:var(--stay-accent);"><i class="fa-solid fa-bed"></i></div>
              <div style="color:var(--stay-muted); font-size:14px; margin-top:8px;">
                <% if(listing.bedrooms) { %><%= listing.bedrooms %> Bedrooms<% } else { %>Bedrooms<% } %>
              </div>
            </div>
            <div style="flex:1;">
              <div style="font-size:18px; color:var(--stay-accent);"><i class="fa-solid fa-bath"></i></div>
              <div style="color:var(--stay-muted); font-size:14px; margin-top:8px;">
                <% if(listing.bathrooms) { %><%= listing.bathrooms %> Bathrooms<% } else { %>Bathrooms<% } %>
              </div>
            </div>
          </div>
        </section>

        <!-- ABOUT -->
        <section class="stayzly-card p-3 mb-3" style="border-radius:12px;">
          <h5 style="margin-bottom:12px;">About this property</h5>
          <p style="color:var(--stay-muted); line-height:1.6;"><%= listing.description || "No description provided." %></p>
        </section>

        <!-- AMENITIES -->
        <section class="stayzly-card p-3 mb-3" style="border-radius:12px;">
          <h5 style="margin-bottom:14px;">Amenities</h5>
          <div class="row" style="color:var(--stay-muted);">
            <div class="col-6 mb-2"><i class="fa-solid fa-wifi" style="color:var(--stay-accent); margin-right:8px;"></i>WiFi</div>
            <div class="col-6 mb-2"><i class="fa-solid fa-tv" style="color:var(--stay-accent); margin-right:8px;"></i>TV</div>
            <div class="col-6 mb-2"><i class="fa-solid fa-kitchen-set" style="color:var(--stay-accent); margin-right:8px;"></i>Kitchen</div>
            <div class="col-6 mb-2"><i class="fa-solid fa-snowflake" style="color:var(--stay-accent); margin-right:8px;"></i>AC</div>
          </div>
        </section>

    <% 
  const isOwner = (function(){
    try {
      if (!currUser || !listing) return false;
      const uid = (currUser._id || currUser).toString();
      const oid = listing.owner._id ? listing.owner._id.toString() : listing.owner.toString();
      return uid === oid;
    } catch (e) { return false; }
  })();
%>

<% if (isOwner) { %>
  <div class="owner-actions">
    
    <a href="/listings/<%= listing._id %>/edit"
       class="owner-btn">
       <i class="fa-solid fa-pen-to-square"></i>
       Edit
    </a>

    <form method="POST"
          action="/listings/<%= listing._id %>?_method=DELETE"
          onsubmit="return confirm('Delete this listing?');"
          style="display:inline;">
      <button type="submit"
              class="owner-btn owner-btn--danger">
        <i class="fa-solid fa-trash"></i>
        Delete
      </button>
    </form>

  </div>
<% } %>


<br>

        <!-- HOST INFO -->
        <section class="stayzly-card p-3 mb-4" style="border-radius:12px;">
          <h5>Hosted by <%= listing.owner.username %></h5>
          <div class="d-flex align-items-center gap-3 mt-3">
            <div style="width:56px;height:56px;border-radius:50%; background:linear-gradient(90deg,var(--stay-accent),#ff8ab2); display:flex; align-items:center; justify-content:center; color:white;">
              <%= listing.owner.username.charAt(0).toUpperCase() %>
            </div>
            <div>
              <div style="font-weight:600;"><%= listing.owner.username %></div>
              <div style="color:var(--stay-muted); font-size:13px;">Superhost • Hosting since 2020</div>
              <div class="mt-3">
                <button class="btn btn-sm" style="background:#0f172a; color:white; border:1px solid rgba(255,255,255,0.04);">📞 Contact Host</button>
              </div>
            </div>
          </div>
        </section>

        

        <!-- MAP (conditional) -->
        <% if (listing.lat && listing.lng) { %>
          <h4 class="mb-3">Location on Map</h4>
          <div id="map" style="height:350px; border-radius:15px; margin-bottom:30px; border:2px solid #555;"></div>
          <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
          <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              const lat = <%= listing.lat %>;
              const lng = <%= listing.lng %>;
              const map = L.map("map").setView([lat, lng], 16);
              L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19 }).addTo(map);
              L.marker([lat, lng]).addTo(map).bindPopup(`<b><%= listing.title %></b><br><%= listing.location %>, <%= listing.pincode %>`).openPopup();
            });
          </script>
        <% } else { %>
          <div class="alert alert-warning p-3 rounded-3 mt-3">Location not available.</div>
        <% } %>

        <hr class="my-4" />

        <!-- REVIEW FORM (backend action unchanged) -->
        <% if (currUser) { %>
          <section class="leave-review-section mb-4 stayzly-card p-3" style="border-radius:12px;">
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation mt-3">
              <!-- ===== ENHANCED STAR WIDGET (keeps hidden radios and names) ===== -->
              <fieldset id="star-rating-fieldset" class="mb-3" style="border:0; padding:0;">
                <legend class="small" style="margin-bottom:8px; color:var(--stay-muted);">Ratings</legend>

                <!-- visual stars (left-to-right 1..5) -->
                <div id="stars-ui" role="radiogroup" aria-label="Rating">
                  <button type="button" class="star-btn" data-value="1" aria-label="1 star" title="1 star">★</button>
                  <button type="button" class="star-btn" data-value="2" aria-label="2 stars" title="2 stars">★</button>
                  <button type="button" class="star-btn" data-value="3" aria-label="3 stars" title="3 stars">★</button>
                  <button type="button" class="star-btn" data-value="4" aria-label="4 stars" title="4 stars">★</button>
                  <button type="button" class="star-btn" data-value="5" aria-label="5 stars" title="5 stars">★</button>
                </div>

                <!-- hidden radios (unchanged) -->
                <div style="display:none;">
                  <input type="radio" id="rate1" name="review[rating]" value="1" />
                  <input type="radio" id="rate2" name="review[rating]" value="2" />
                  <input type="radio" id="rate3" name="review[rating]" value="3" />
                  <input type="radio" id="rate4" name="review[rating]" value="4" />
                  <input type="radio" id="rate5" name="review[rating]" value="5" />
                </div>

                
              </fieldset>
              <!-- ===== END STAR WIDGET ===== -->

              <div class="mb-3">
                <label class="form-label">Comments</label>
                <textarea name="review[comment]" rows="4" class="form-control stayzly-dark-input" required></textarea>
                <div class="invalid-feedback">Required</div>
              </div>

              <button class="btn" style="background-color:#fe242f; color:white;">Submit</button>
            </form>
          </section>
        <% } %>

        <!-- ALL REVIEWS -->
        <section class="all-reviews-section">
          <h4>All Reviews</h4>
          <div class="row g-3 mt-2">
            <% for (let review of listing.reviews) { %>
              <div class="col-12">
                <article class="review-card">
                  <div class="review-head">
                    <div style="display:flex;align-items:center;gap:12px;">
                      <div class="review-avatar">
                        <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                      </div>
                      <div class="review-meta">
                        <div class="name">@<%= review.author ? review.author.username : 'user' %></div>
                        <div class="date">
                          <% if (review.createdAt) { %>
                            <%= review.createdAt.toLocaleDateString() %>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <div class="review-stars" aria-hidden="true">
                      <% for (let i = 0; i < review.rating; i++) { %>★<% } %>
                    </div>
                  </div>

                  <div class="review-body">
                    <%= review.comment %>
                  </div>

                  <div class="review-footer">
                    <button class="btn-helpful">👍 Helpful</button>

                    <% if (currUser && review.author._id.equals(currUser._id)) { %>
                      <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" style="display:inline;">
                        <button class="btn-delete">Delete</button>
                      </form>
                    <% } %>
                  </div>
                </article>
              </div>
            <% } %>
          </div>
        </section>

      </div> <!-- END LEFT COLUMN -->

      <!-- RIGHT: Sidebar -->
      <aside class="col-md-4">
        <div class="stayzly-card p-3 mb-3" style="border-radius:12px;">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div style="color:var(--stay-muted); font-size:14px;">Price</div>
              <div style="font-weight:700; font-size:18px;">₹ <%= listing.price.toLocaleString("en-IN") %> <span style="font-weight:400;">/ night</span></div>
            </div>
            <div>
              <% if(listing.isVerified) { %>
                <div class="badge verified">✔</div>
              <% } %>
            </div>
          </div>

          <!-- reservation UI (unchanged logic) -->
          <div class="mt-3">
            <label class="small">Check-in</label>
            <input id="checkin" name="checkin" type="text" class="form-control stayzly-dark-input mb-2 date-input" placeholder="dd-mm-yyyy" autocomplete="off" />
            <label class="small">Check-out</label>
            <input id="checkout" name="checkout" type="text" class="form-control stayzly-dark-input mb-2 date-input" placeholder="dd-mm-yyyy" autocomplete="off" />
            <label class="small">Guests</label>
            <input id="guests" name="guests" type="number" min="1" max="16" value="1" class="form-control stayzly-dark-input mb-3" />
            
            <button id="reserve-now-btn" type="button" class="btn w-100" style="background:linear-gradient(90deg,var(--stay-accent),#ab6cff); color:white;">
              Reserve Now
            </button>

            
            
          </div>
        </div>

        <div class="stayzly-card p-3" style="border-radius:12px;">
          <div style="color:var(--stay-muted); font-size:14px;">₹<%= listing.price.toLocaleString("en-IN") %> × 5 nights</div>
          <div class="d-flex justify-content-between mt-2">
            <div style="color:var(--stay-muted);">Service fee</div>
            <div>₹3,600</div>
          </div>
          <hr style="border-color: rgba(255,255,255,0.04);" />
          <div class="d-flex justify-content-between" style="font-weight:700;">
            <div>Total</div>
            <div>₹<%= (listing.price * 5 + 3600).toLocaleString("en-IN") %></div>
          </div>
        </div>
      </aside>

    </div> <!-- row -->
  </main>

  <!-- Thumbnail -> Main image click -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const thumbs = document.querySelectorAll(".thumb-img");
      const main = document.getElementById("main-image");
      if (!thumbs || !main) return;
      thumbs.forEach(t => t.addEventListener("click", () => main.src = t.src));
    });
  </script>

  <!-- Reserve now behavior (unchanged) -->
  <script>
document.addEventListener("DOMContentLoaded", function () {
  const btn = document.getElementById("reserve-now-btn");
  if (!btn) return;
  function findFlashContainer() {
    const selectors = [".flash", ".flash-container", ".flash-message", ".alerts", ".alert-wrap", "#flash", "#flash-container", ".container-fluid", "body"];
    for (const s of selectors) { const el = document.querySelector(s); if (el) return el; }
    return document.body;
  }
  function showFlash(message, type = "success", duration = 4500) {
    const container = findFlashContainer();
    const useBootstrap = typeof bootstrap !== "undefined" || document.querySelector(".alert");
    let flashEl;
    if (useBootstrap) {
      flashEl = document.createElement("div");
      flashEl.className = `alert ${type === "error" ? "alert-danger" : "alert-success"} alert-dismissible fade show`;
      flashEl.setAttribute("role", "alert");
      flashEl.innerHTML = `${message}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>`;
      if (container === document.body) { const topTarget = document.querySelector(".container-fluid") || document.querySelector("main") || document.body; topTarget.insertBefore(flashEl, topTarget.firstChild); }
      else container.insertBefore(flashEl, container.firstChild);
    } else {
      flashEl = document.createElement("div");
      flashEl.className = "custom-fallback-flash";
      flashEl.innerHTML = message;
      Object.assign(flashEl.style, { padding: "12px 16px", borderRadius: "8px", background: "linear-gradient(90deg, rgba(79,140,255,0.12), rgba(255,122,182,0.10))", color: "#fff", boxShadow: "0 6px 20px rgba(0,0,0,0.5)", margin: "14px auto", maxWidth: "880px", textAlign: "center", zIndex: 99999, fontWeight: 600 });
      const topTarget = document.querySelector(".container-fluid") || document.querySelector("main") || document.body;
      topTarget.insertBefore(flashEl, topTarget.firstChild);
    }
    setTimeout(() => { try { if (useBootstrap) { flashEl.classList.remove("show"); flashEl.classList.add("hide"); setTimeout(() => flashEl.remove(), 300); } else flashEl.remove(); } catch (e) { if (flashEl && flashEl.parentNode) flashEl.parentNode.removeChild(flashEl); } }, duration);
  }
  const RESERVE_MSG = "The Host will contact you shortly!";
  btn.addEventListener("click", () => { btn.disabled = true; showFlash(RESERVE_MSG, "success", 4500); setTimeout(()=> btn.disabled = false, 5000); });
});
</script>

  <!-- Enhanced star widget script (keeps backend radio inputs intact) -->
  <script>
  (function () {
    const starBtns = Array.from(document.querySelectorAll('#stars-ui .star-btn'));
    if (!starBtns.length) return;

    const radios = {
      '1': document.querySelector('input[name="review[rating]"][value="1"]'),
      '2': document.querySelector('input[name="review[rating]"][value="2"]'),
      '3': document.querySelector('input[name="review[rating]"][value="3"]'),
      '4': document.querySelector('input[name="review[rating]"][value="4"]'),
      '5': document.querySelector('input[name="review[rating]"][value="5"]'),
    };

    function setVisualRating(n) {
      starBtns.forEach(btn => {
        const v = Number(btn.getAttribute('data-value'));
        if (v <= n) btn.classList.add('star-selected');
        else btn.classList.remove('star-selected');
      });
    }

    (function initFromRadios(){
      for (let i=1;i<=5;i++) if (radios[String(i)] && radios[String(i)].checked) { setVisualRating(i); return; }
      setVisualRating(0);
    })();

    function playSparkle(btn) {
      btn.classList.remove('star-animate');
      void btn.offsetWidth;
      btn.classList.add('star-animate');
      setTimeout(()=> btn.classList.remove('star-animate'), 700);
    }

    starBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const val = btn.getAttribute('data-value');
        if (radios[val]) radios[val].checked = true;
        setVisualRating(Number(val));
        playSparkle(btn);
        btn.focus();
      });

      btn.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') { e.preventDefault(); btn.click(); }
        if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { e.preventDefault(); const cur = Number(btn.getAttribute('data-value')); const prev = starBtns.find(s => Number(s.getAttribute('data-value')) === cur - 1); if (prev) prev.focus(); }
        if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { e.preventDefault(); const cur = Number(btn.getAttribute('data-value')); const next = starBtns.find(s => Number(s.getAttribute('data-value')) === cur + 1); if (next) next.focus(); }
      });

      btn.addEventListener('mouseover', () => {
        const v = Number(btn.getAttribute('data-value'));
        setVisualRating(v);
      });
      btn.addEventListener('mouseout', () => {
        let sel = 0; for (let i=1;i<=5;i++) if (radios[String(i)] && radios[String(i)].checked) sel = i;
        setVisualRating(sel);
      });
      btn.addEventListener('focus', () => { const v = Number(btn.getAttribute('data-value')); setVisualRating(v); });
      btn.addEventListener('blur', () => { let sel = 0; for (let i=1;i<=5;i++) if (radios[String(i)] && radios[String(i)].checked) sel = i; setVisualRating(sel); });
    });

    const form = (function findParentForm(){
      let el = document.getElementById('star-rating-fieldset');
      while (el && el.tagName !== 'FORM') el = el.parentElement;
      return el && el.tagName === 'FORM' ? el : null;
    })();
    if (form) {
      form.addEventListener('submit', () => {
        const any = Object.values(radios).some(r=>r && r.checked);
        if (!any && radios['1']) radios['1'].checked = true;
      });
    }
  })();
  </script>

</body>
