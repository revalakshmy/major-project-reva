<% layout("/layouts/boilerplate") %>
<style>
/* ----- hotfix / fallback to ensure original starability labels (safe) ----- */
.starability-slot {
  display: flex !important;
  flex-direction: row-reverse !important;
  align-items: center !important;
  gap: 10px !important;
  margin: 8px 0 16px !important;
  padding: 6px 4px !important;
  background: transparent !important;
  border: 0 !important;
  position: relative !important;
}

.starability-slot input[type="radio"],
.starability-slot .input-no-rate {
  position: absolute !important;
  left: -9999px !important;
  opacity: 0 !important;
  width: 0 !important;
  height: 0 !important;
}

.starability-slot label {
  display: inline-block !important;
  font-size: 28px !important;
  line-height: 1 !important;
  user-select: none !important;
  cursor: pointer !important;
  color: rgba(255,255,255,0.85) !important;
  transition: transform 150ms cubic-bezier(.2,.9,.2,1), color 150ms ease, text-shadow 150ms ease !important;
  text-shadow: 0 2px 8px rgba(0,0,0,0.45) !important;
}

.starability-slot label::before {
  content: "★" !important;
  display: inline-block !important;
  transform-origin: 50% 50% !important;
  -webkit-font-smoothing: antialiased !important;
}

.starability-slot label:hover::before,
.starability-slot label:hover ~ label::before {
  transform: scale(1.14) !important;
  color: #ffd84d !important;
  text-shadow: 0 6px 18px rgba(255,200,70,0.15) !important;
}

.starability-slot[data-rating="1"] label:nth-of-type(-n+1)::before,
.starability-slot[data-rating="2"] label:nth-of-type(-n+2)::before,
.starability-slot[data-rating="3"] label:nth-of-type(-n+3)::before,
.starability-slot[data-rating="4"] label:nth-of-type(-n+4)::before,
.starability-slot[data-rating="5"] label:nth-of-type(-n+5)::before {
  color: #ffd84d !important;
  transform: scale(1.06) !important;
  text-shadow: 0 8px 26px rgba(255,200,70,0.12) !important;
}

.starability-slot label span {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  margin: -1px !important;
  padding: 0 !important;
  overflow: hidden !important;
  clip: rect(0 0 0 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

/* ----- Enhanced star UI styles (scoped) ----- */
#stars-ui {
  display:flex;
  gap:10px;
  align-items:center;
  user-select: none;
}

/* Primary visual star buttons */
.star-btn {
  appearance: none;
  -webkit-appearance: none;
  all: unset;
  cursor: pointer;
  font-size: 34px;
  line-height: 1;
  color: rgba(255,255,255,0.22);
  display: inline-flex;
  align-items:center;
  justify-content:center;
  padding: 6px;
  border-radius: 8px;
  transition: transform 180ms cubic-bezier(.2,.9,.2,1), color 160ms ease, text-shadow 160ms ease, filter 160ms ease;
  position: relative;
  will-change: transform, color;
}

/* subtle halo behind star (improves visibility on dark backgrounds) */
.star-btn::before {
  content: '';
  position: absolute;
  inset: -6px;
  border-radius: 12px;
  background: radial-gradient(circle at 30% 30%, rgba(255,210,120,0.06), rgba(255,140,76,0.02));
  pointer-events: none;
  transition: opacity 160ms ease, transform 160ms ease;
  opacity: 0;
}

/* hover pop */
.star-btn:hover,
.star-btn:focus {
  transform: translateY(-6px) scale(1.08);
  color: #ffd84d;
  text-shadow: 0 10px 28px rgba(255,200,70,0.14);
  outline: none;
}
.star-btn:hover::before,
.star-btn:focus::before { opacity: 1; transform: scale(1.02); }

/* selected state (JS will add class star-selected) */
.star-selected {
  color: #ffd84d !important;
  transform: scale(1.06) !important;
  text-shadow: 0 12px 36px rgba(255,200,70,0.16) !important;
  filter: drop-shadow(0 4px 12px rgba(255,180,70,0.10));
}

/* click sparkle bloom */
.star-btn::after {
  content: "";
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  left: 50%;
  top: 10%;
  transform: translate(-50%, -50%) scale(0.18);
  background: radial-gradient(circle, rgba(255,230,160,1) 0%, rgba(255,190,90,0.9) 40%, rgba(255,120,50,0.0) 70%);
  opacity: 0;
  pointer-events: none;
}

@keyframes star-sparkle {
  0%   { opacity: 1; transform: translate(-50%, -50%) scale(0.18) rotate(0deg); filter: blur(0); }
  50%  { opacity: 1; transform: translate(-50%, -110%) scale(1.2) rotate(18deg); filter: blur(0.6px); }
  100% { opacity: 0; transform: translate(-50%, -160%) scale(1.6) rotate(36deg); filter: blur(1.6px); }
}

.star-animate::after {
  animation: star-sparkle 520ms cubic-bezier(.2,.9,.2,1) forwards;
}

/* responsive tweak */
@media (max-width:480px) {
  .star-btn { font-size: 28px; padding:4px; }
}
</style>

<body>
  <main class="container my-5">
    <a href="/listings" class="stayzly-back-btn mb-3">
      <i class="fa-solid fa-arrow-left"></i>
      Back to Stays
    </a>

    <div class="row g-4">
      <!-- LEFT: Gallery + Details -->
      <div class="col-md-8">

        <!-- GALLERY -->
        <section class="stayzly-card mb-4 p-3" style="background:transparent; border-radius:14px;">
          <div class="row gx-3">
            <div class="col-8">
              <!-- main image -->
              <img id="main-image" src="<%= listing.image.url %>" alt="main image" class="card-img-top" style="border-radius:12px; height:420px; width:100%; object-fit:cover;">
            </div>
            <div class="col-4">
              <!-- thumbnail grid -->
              <div class="row g-2">
                <div class="col-12">
                  <img class="thumb-img card-img-top" src="<%= listing.image.url %>" style="height:130px; object-fit:cover; border-radius:10px; cursor:pointer;">
                </div>
                <div class="col-6">
                  <img class="thumb-img card-img-top" src="<%= listing.image.url %>" style="height:95px; object-fit:cover; border-radius:10px; cursor:pointer;">
                </div>
                <div class="col-6">
                  <img class="thumb-img card-img-top" src="<%= listing.image.url %>" style="height:95px; object-fit:cover; border-radius:10px; cursor:pointer;">
                </div>
                <div class="col-6 mt-2">
                  <img class="thumb-img card-img-top" src="<%= listing.image.url %>" style="height:95px; object-fit:cover; border-radius:10px; cursor:pointer;">
                </div>
                <div class="col-6 mt-2">
                  <img class="thumb-img card-img-top" src="<%= listing.image.url %>" style="height:95px; object-fit:cover; border-radius:10px; cursor:pointer;">
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- TITLE + META -->
