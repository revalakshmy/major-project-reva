<style>
  /* --- BRAND GRADIENT LOGO + TEXT --- */
  .stayzly-brand-wrapper {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    align-items: center;
    text-decoration: none;
  }

  .stayzly-logo-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: 700;
    font-size: 22px;
    color: white;
    background: linear-gradient(135deg, #6a5cff, #ff6ad5);
    box-shadow: 0px 0px 15px rgba(130, 100, 255, 0.25);
  }

  .stayzly-logo-text {
    font-size: 28px;
    font-weight: 600;
    background: linear-gradient(135deg, #7aa7ff, #ff6ad5);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Keep your existing right side styling untouched */
  .navbar-right-links {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  #theme-toggle {
    margin-left: 10px;
    border-radius: 50%;
    padding: 6px 10px;
  }

  .stayzly-logo-img {
  width: 38px;     /* change size here */
  height: 38px;    /* keeps it perfectly proportional */
  border-radius: 50%; /* if you want it round like the sample */
}


</style>

<nav class="navbar navbar-expand-md border-bottom sticky-top" style="background:#0B1220;">
  <div class="container-fluid position-relative">

    <!-- BRAND (CENTERED) -->
    <a href="/listings" class="stayzly-brand-wrapper">
      <img src="/images/d9de5b83-07d5-4315-8d79-8f7eb2af5451.svg" class="stayzly-logo-img" alt="StayZly Logo">
      <div class="stayzly-logo-text">StayZly</div>
    </a>


    <!-- TOGGLER -->
    <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- RIGHT SIDE NAV OPTIONS -->
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      
      
      <div class="navbar-right-links">
        <!-- Theme Button (unchanged functionality) -->
        <button id="theme-toggle" class="btn btn-outline-secondary">
          <i id="theme-icon" class="fa-solid fa-sun-bright"></i>
        </button>

        <a class="nav-link" href="/about">About</a>

       <a class="nav-link" href="/listings/new">Add Property</a>
        <% if (!currUser) { %>
          <a class="nav-link" href="/signup">Sign up</a>
          <a class="nav-link" href="/login">Login</a>
        <% } %>

        <% if (currUser) { %>
          <a class="nav-link" href="/logout">Logout</a>
        <% } %>

        <!-- Theme Button (unchanged functionality) -->
        <button id="theme-toggle" class="btn btn-outline-secondary">
          <i id="theme-icon" class="fa-solid fa-sun-bright"></i>
        </button>

      </div>
    </div>

  </div>
</nav>
